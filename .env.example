# Postgres connection (local dev or Amazon RDS)
DATABASE_URI=postgres://iff:iff@127.0.0.1:5432/iff
# Long random string used to sign admin sessions. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me
# Public URL of the site (used for links, previews and CORS)
SERVER_URL=http://localhost:3000

# Amazon S3 for uploaded media, documents and résumés (leave blank to store on local disk in dev)
S3_BUCKET=
S3_REGION=ap-south-1
# Only needed outside AWS. On ECS the task role grants access, so leave these empty there.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
